# Upvvan — local environment
#
# Copy to .env and adjust. `make setup` does this for you.
# Phase 0 needs only DATABASE_URL and PAYLOAD_SECRET.

# ── Database ────────────────────────────────────────────────────────────────
# Postgres 18, per C-4. Matches infra/dev-services.yml (host port 55432 so this
# stack can run alongside another local project).
DATABASE_URL=postgres://upvvan:upvvan_dev@localhost:55432/upvvan

# ── Payload ─────────────────────────────────────────────────────────────────
# Must be >= 32 chars. Generate: openssl rand -hex 32
PAYLOAD_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── Customer identity (better-auth — the ONLY owner of customer identity) ───
# See STACK-DECISION.md §5. Must be >= 32 chars, different from PAYLOAD_SECRET.
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3100

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3100
NEXT_PUBLIC_SERVER_URL=http://localhost:3100

# ── Object storage (RustFS in dev) ───────────────────────────────────────────
# CAVEAT: RustFS does not auto-create buckets. Run `make storage-bucket` once.
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=upvvan-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ── Email (Mailpit in dev) ───────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=51025
EMAIL_FROM=hello@upvvan.local

# ── Business config ─────────────────────────────────────────────────────────
# Legal entity + principal address. Required disclosures under the Consumer
# Protection (E-Commerce) Rules 2020 — surfaced in the compliance console.
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=