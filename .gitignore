# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
.turbo/
out/
dist/
*.tsbuildinfo

# GENERATED — never hand-edited. Regenerate with:
#   pnpm payload generate:types
#   pnpm payload generate:importmap
#   make design-export   (src/app/theme.css from DESIGN.md)
src/payload-types.ts
src/payload-generated-schema.ts
src/app/theme.css

# Migrations: the generated baseline DDL is reproducible via
# `pnpm payload migrate:create initial_baseline`, so the .ts is committed but
# the snapshot .json is not.
src/migrations/*.json

# Secrets — .env.example is the committed template
.env
.env.local
.env.*.local

# Test output
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Editor / OS
.DS_Store
.idea/

# OS junk
*.log
npm-debug.log*

# Local scratch
trash/